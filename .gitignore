# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Package managers and installers
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Local databases and generated audit images
backend/data/*.sqlite
backend/data/*.sqlite-journal
backend/data/images/*
!backend/data/images/.gitkeep

# Environment and secrets (keep .env.example)
.env
.env.local
.env.*.local
*.pem
*.key

# Frontend Node & Vite artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and Editor metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
